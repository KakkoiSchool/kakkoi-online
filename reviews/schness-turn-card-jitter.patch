diff --git a/test/shell.test.js b/test/shell.test.js
index 90ac361..b709f4b 100644
--- a/test/shell.test.js
+++ b/test/shell.test.js
@@ -555,3 +555,18 @@ test('only a turn still in flight animates, never a finished game', async () =>
   assert.match(main, /function matchOver\(/);
   assert.match(main, /active-player', position\.turn === humanColor && !matchOver/);
 });
+
+test('the turn card keeps its height, so a tap never moves the board or the reserve', async () => {
+  const main = await readFile(resolve(root, 'src/main.js'), 'utf8');
+  const css = await readFile(resolve(root, 'styles.css'), 'utf8');
+  // The detail slot is reserved at three lines whether or not there is text,
+  // and the paragraph is never display:none — either would let the card shrink
+  // to a headline and grow back on the next click.
+  assert.match(css, /\.turn-detail\s*{[^}]*min-height:\s*calc\(3 \* 1\.55em\)/);
+  assert.doesNotMatch(main, /turnDetail\.hidden/);
+  // Deselect shares the headline row instead of adding one of its own.
+  assert.match(css, /\.turn-card\s*{[^}]*grid-template-areas:\s*"headline action"\s*"detail detail"/);
+  assert.match(css, /\.turn-action\s*{[^}]*grid-area:\s*action/);
+  // The phone layout trims the top for the board; the bottom still gets a margin.
+  assert.match(css, /\.game-page\s*{[^}]*padding-bottom:\s*max\(1rem, env\(safe-area-inset-bottom\)\)/);
+});
