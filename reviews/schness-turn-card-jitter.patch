-/* The turn card names both legal action types every turn. */
+/*
+ * The turn card names both legal action types every turn — and never changes
+ * height while it does. Its detail went from nothing to three lines the moment
+ * a piece was selected, so every tap pushed the reserve out from under the
+ * finger, and on desktop moved the board itself. The detail slot is reserved
+ * at the tallest guidance it can hold, and the action button sits beside the
+ * headline instead of adding a row of its own.
+ */
 .turn-card {
   display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  grid-template-areas:
+    "headline action"
+    "detail detail";
+  align-items: center;
   justify-items: start;
-  gap: 7px;
+  gap: 7px 12px;
   border: 1px solid var(--line);
   border-radius: 9px;
   background: var(--surface);
@@ -209,6 +223,7 @@
 }
 
 .turn-headline {
+  grid-area: headline;
   display: flex;
   align-items: center;
   gap: 8px;
@@ -230,6 +245,11 @@
 }
 
