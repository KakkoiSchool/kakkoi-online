+
+const place = (pieces, { banks = { [WHITE]: [], [BLACK]: [] }, repetitions = {} } = {}) => {
+  const board = Array(16).fill(null);
+  for (const [square, owner, kind] of pieces) board[square] = { owner, piece: kind };
+  return createPosition({ board, banks, turn: WHITE, repetitions });
+};
+
+test('the transposition cache never changes the answer', () => {
+  // The old cache stored a node's value after an alpha-beta cutoff as if it
+  // were exact, and at depth 4 that changed the chosen move in 2 of 60 sampled
+  // positions. A bound now narrows the window instead. Depth 4 is the first
+  // depth at which a transposition can occur inside the tree, so it is the
+  // only depth that can catch this — hence a slow test, kept to two positions.
+  let seed = 4242;
+  const rnd = () => { seed = (seed * 1103515245 + 12345) & 0x7fffffff; return seed / 0x7fffffff; };
+  let position = createInitialPosition();
+  let checked = 0;
+  for (let ply = 0; ply < 30 && checked < 2; ply += 1) {
+    const actions = legalActions(position);
+    if (!actions.length || getResult(position)) break;
+    if (position.phase === 'play' && ply % 6 === 4) {
+      checked += 1;
+      const cached = chooseAction(position, { depth: 4, contempt: 0 });
+      const exact = chooseAction(position, { depth: 4, contempt: 0, useCache: false });
+      assert.equal(actionKey(cached), actionKey(exact), `ply ${ply}: the cache changed the move`);
+    }
+    position = applyAction(position, actions[Math.floor(rnd() * actions.length)]);
+  }
+  assert.equal(checked, 2);
+});
+
+test('the search counts repetition along its own path without copying the map', () => {
+  // The root map is shared read-only by every position the search builds.
+  const start = place([[15, WHITE, KING], [0, BLACK, KING]], { banks: { [WHITE]: [ROOK], [BLACK]: [] } });
+  const before = JSON.stringify(start.repetitions);
+  chooseAction(start, { depth: 3 });
+  assert.equal(JSON.stringify(start.repetitions), before, 'the search wrote into the root map');
+  // And a repetition the search would complete is still seen as a draw: a
+  // king step that recreates a twice-seen position is a draw, so when white is
+  // down a rook the bot takes it, contempt or not.
+  const pieces = [[15, WHITE, KING], [0, BLACK, KING], [1, BLACK, ROOK]];
+  const drawMove = { type: 'move', from: 15, to: 14 };
+  const repeated = positionKey(applyAction(place(pieces), drawMove));
+  const down = place(pieces, { repetitions: { [repeated]: 2 } });
+  assert.equal(actionKey(chooseAction(down, { depth: 3 })), actionKey(drawMove));
+});
+
+test('with material level the bot declines a draw it used to shuffle into', () => {
+  // Sharp against itself ended in threefold repetition fourteen games out of
+  // sixteen: a draw scored 0 and level material scored about 0. Contempt makes
+  // a draw worth a fifth of a knight against the bot, so it repeats only when
+  // it is worse off than that. Bishops each; the king step to d3 completes a
+  // repetition.
+  const pieces = [[3, WHITE, KING], [14, BLACK, KING], [0, WHITE, BISHOP], [1, BLACK, BISHOP]];
+  const drawMove = { type: 'move', from: 3, to: 7 };
+  const repeated = positionKey(applyAction(place(pieces), drawMove));
+  const level = place(pieces, { repetitions: { [repeated]: 2 } });
+  assert.equal(actionKey(chooseAction(level, { depth: 2, contempt: 0 })), actionKey(drawMove), 'without contempt the draw is taken');
+  assert.notEqual(actionKey(chooseAction(level, { depth: 2 })), actionKey(drawMove), 'with contempt it is declined');
+});
